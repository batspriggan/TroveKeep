{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://admin:password@localhost:27017",
    "DatabaseName": "trovekeep"
  },
  "Migration": {
    "BackupDir": "",
    "DefaultCollectionName": "Casa"
  },
  "Auth": {
    "Oidc": {
      "Enabled": false,
      "Authority": "",
      "ClientId": "",
      "ClientSecret": "",
      "Scopes": "openid profile email",
      "AutoProvision": true,
      "RequireHttpsMetadata": true
    }
  },
  "ArchivesPath": "../archives",
  "LabelTool": {
    "Binary": "label-tool",
    "DefaultSize": "large",
    "DefaultCopies": 1,
    "Prefix": "LEGO",
    "TimeoutSeconds": 60,
    "PublicBaseUrl": "",
    "Mode": "client",
    "ServerUrl": "",
    "ServerToken": "",
    "ServerTimeoutSeconds": 15
  }
}
