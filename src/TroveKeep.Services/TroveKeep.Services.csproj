<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TroveKeep.Core\TroveKeep.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CurrentUser needs IHttpContextAccessor, the auth services use PasswordHasher<T>, and
         ImageService/LabelServerClient use IHttpClientFactory: all of these ship with the shared
         framework, so no individual Microsoft.Extensions.* package reference is needed. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
